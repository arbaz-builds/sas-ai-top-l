# Get a key from https://build.nvidia.com  (never commit the real .env)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# VLM_MODEL=meta/llama-3.2-11b-vision-instruct
# TOP_K=6
# MAX_ANSWER_IMAGES=1

# Pinecone (used by mmrag/rag.py)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=your-index-name

# Optional: chat model used by agent1
# CHAT_MODEL=meta/llama-3.3-70b-instruct

# Chat memory (Postgres). Leave empty for local development: memory is then kept in RAM only.
DATABASE_URL= data_base_url

